{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ORRERY_PROJECT=orrery ORRERY_URL=http://localhost:9010 node \"$CLAUDE_PROJECT_DIR/channel/orrery-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ORRERY_PROJECT=orrery ORRERY_URL=http://localhost:9010 node \"$CLAUDE_PROJECT_DIR/channel/orrery-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ORRERY_PROJECT=orrery ORRERY_URL=http://localhost:9010 node \"$CLAUDE_PROJECT_DIR/channel/orrery-hook.mjs\"",
            "timeout": 5,
