# Copy to .env, beside compose.yml; every line is optional.
ORRERY_PORT=9000
# A folder to keep the database in (by default, the orrery-data volume); never a synced one
# ORRERY_DATA=/path/to/a/folder
# Postgres instead of the SQLite file: the bundled one (with the profile), or a URL of your own
# COMPOSE_PROFILES=postgres
# ORRERY_DATABASE=postgres://orrery:orrery@postgres:5432/orrery
# This orrery's name when you run more than one; personal by default. A second one also needs its own
# COMPOSE_PROJECT_NAME (e.g. orrery-work) and ORRERY_PORT
# ORRERY_ENVIRONMENT=work
# Open it to the network (by default, this machine only): it then asks for a login, see docs/running.md
# ORRERY_HOST=0.0.0.0
# Login: on always asks, off never (loopback only); unset, it comes on by itself. See docs/running.md
# ORRERY_AUTH=on
# ORRERY_OIDC_ISSUER=
# ORRERY_OIDC_CLIENT_ID=
# ORRERY_OIDC_CLIENT_SECRET=
# Host names it answers to besides localhost and IP addresses
# ORRERY_ALLOWED_HOSTS=orrery.lan
# Other sites whose pages may use the API, for orrery's page hosted there: exact origins (docs/running.md)
# ORRERY_ALLOWED_ORIGINS=https://app.example.com
# off serves the API alone, without the pages
# ORRERY_PAGES=off
# Turns on secrets, keys agents use without seeing (openssl rand -base64 32); keep it apart from copies of the database
# ORRERY_SECRET_KEY=
# Set false to stop asking GitHub, at start and every 12 hours, whether a newer orrery is out
# ORRERY_UPDATE_CHECK=false
