# Copy to .env, beside compose.yml; every line is optional.
ORRERY_PORT=9000
# Where your clone of the repo is, when it isn't this folder: Connect points the connected repos at it
# ORRERY_REPO_DIR=/path/to/orrery
# A folder for the backups that leaves this computer (by default the orrery-backup volume, on the same disk)
# ORRERY_BACKUP=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/orrery
# Back up into a Postgres database instead of the folder: an empty one, or this orrery's backup from before
# ORRERY_BACKUP_DATABASE=postgres://user:password@host:5432/orrery-backup
# A folder to keep the database in (by default, the orrery-data volume); never a synced one
# ORRERY_DATA=/path/to/a/folder
# Postgres instead of the SQLite file: the bundled one (with the profile), or a URL of your own
# COMPOSE_PROFILES=postgres
# ORRERY_DATABASE=postgres://orrery:orrery@postgres:5432/orrery
# This orrery's name when you run more than one; personal by default. A second one also needs its own
# COMPOSE_PROJECT_NAME (e.g. orrery-work), ORRERY_PORT and ORRERY_BACKUP
# ORRERY_ENVIRONMENT=work
# Open it to the network (by default, this machine only): there are no accounts
# ORRERY_HOST=0.0.0.0
# Host names it answers to besides localhost and IP addresses
# ORRERY_ALLOWED_HOSTS=orrery.lan
# Turns on secrets, keys agents use without seeing (openssl rand -base64 32); keep it out of the backups
# ORRERY_SECRET_KEY=
