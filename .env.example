# Copy to .env; every line is optional.
ORRERY_PORT=9000
# A folder to keep the database in (by default, the orrery-data volume); not a synced one
# ORRERY_DATA=/path/to/a/folder
# Postgres instead of the SQLite file: the bundled one (with the profile), or a URL of your own
# COMPOSE_PROFILES=postgres
# ORRERY_DATABASE=postgres://orrery:orrery@postgres:5432/orrery
# A folder to keep the backups in (by default, the orrery-backup volume)
# ORRERY_BACKUP=/path/to/a/synced/folder
# This Orrery's name when you run more than one (see the README); personal by default
# ORRERY_ENVIRONMENT=work
# Open it to the network (by default, this machine only): read SECURITY.md first
# ORRERY_HOST=0.0.0.0
# Host names it answers to besides localhost and IP addresses
# ORRERY_ALLOWED_HOSTS=orrery.lan
# Turns on secrets, keys agents use without seeing (openssl rand -base64 32); keep it out of the backups
# ORRERY_SECRET_KEY=
# Build from a release on GitHub instead of this folder, so a switched branch never ends up in the image
# ORRERY_BUILD_CONTEXT=https://github.com/steffendybvik/orrery.git#main
# Working on Orrery: the dev server, as its own compose project with a demo (see docs/development.md)
# COMPOSE_PROJECT_NAME=orrery-dev
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# ORRERY_SEED=1
