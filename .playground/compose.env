# The playground: orrery's dev server (nuxt dev on this checkout) as its own compose project, with its database
# in .playground/data, apart from the Orrerys you use. Run it with .playground/play.
COMPOSE_PROJECT_NAME=orrery-playground
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# The Rust API swap's one switch (ORR-1051): 1 runs the Rust API in a container of its own and makes its domains its
# alone (docker-compose.api.yml, which play adds); 0 is the Nuxt server alone. Then .playground/play down and up.
ORRERY_RUST_API=1
ORRERY_ENVIRONMENT=playground
ORRERY_PORT=9001
ORRERY_DATA=./.playground/data
ORRERY_BACKUP=./.playground/backup
